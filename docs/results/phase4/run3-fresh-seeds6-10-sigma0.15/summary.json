 "label_rules": {
  "healthy": "background only, every service/path check passes -> healthy",
  "busy_healthy": "one link 80-93 % utilization (spiky or steady), latency normal, drops only background growth (< 10/interval) -> not a fault; any diagnosed/probable answer is a false diagnosis",
  "link_congestion": "utilization sustained >= 91 % on the link; corroborated by probe latency (second source) -> diagnosed; by queue drops only (same source as utilization) -> probable",
  "interface_fault": "errors and/or flaps rising >= 15/interval on the link plus downstream loss 3-8 % from a probe -> diagnosed",
  "weak_wifi": "AP RSSI -86..-77 dBm and retries 25-40 % with a clean AP uplink -> diagnosed",
  "dns_failure": "2-4 clients fail DNS, server reachable; reachability from the ICMP poller -> diagnosed; DNS and reachability from the same client probe (P4-3) -> probable",
  "dhcp_failure": "as dns_failure, for DHCP",
  "stale_telemetry": "a congestion or interface fault whose key series is missing or 20+ minutes old -> insufficient_evidence"
 },
