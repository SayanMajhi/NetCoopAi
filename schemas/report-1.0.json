{
  "$defs": {
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "interpretation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the value means against its configured threshold, e.g. 'above critical 90 percent' (contract-1.0.4)",
          "title": "Interpretation"
        },
        "interval_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cumulative counters only: increase since the previous sample of the same series. Null for non-counters, the first sample, after a gap, or on a counter reset",
          "title": "Interval Delta"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "evidence_id",
        "metric",
        "value",
        "unit",
        "source_id"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "Status": {
      "enum": [
        "diagnosed",
        "probable",
        "healthy",
        "insufficient_evidence",
        "invalid_input",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "$id": "report-1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "suspected_root_cause": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "diagnosed",
              "probable"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "suspected_root_cause": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "confidence": {
            "type": "number"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "invalid_input",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "invalid_input"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validation_errors": {
            "minItems": 1
          }
        },
        "required": [
          "validation_errors"
        ]
      }
    }
  ],
  "properties": {
    "affected_devices": {
      "items": {
        "type": "string"
      },
      "title": "Affected Devices",
      "type": "array"
    },
    "affected_segments": {
      "items": {
        "type": "string"
      },
      "title": "Affected Segments",
      "type": "array"
    },
    "agent_findings": {
      "items": {
        "type": "string"
      },
      "title": "Agent Findings",
      "type": "array"
    },
    "agent_trace_id": {
      "title": "Agent Trace Id",
      "type": "string"
    },
    "alternative_causes": {
      "items": {
        "type": "string"
      },
      "title": "Alternative Causes",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence"
    },
    "confidence_method": {
      "default": "heuristic-v1",
      "title": "Confidence Method",
      "type": "string"
    },
    "evidence_sources": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Sources",
      "type": "array"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "normalization_log": {
      "items": {
        "type": "string"
      },
      "title": "Normalization Log",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    },
    "signature_version": {
      "title": "Signature Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "One plain-language sentence stating the outcome (contract-1.0.4)",
      "title": "Summary"
    },
    "supporting_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Supporting Evidence",
      "type": "array"
    },
    "suspected_root_cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Suspected Root Cause"
    },
    "validation_errors": {
      "items": {
        "type": "string"
      },
      "title": "Validation Errors",
      "type": "array"
    }
  },
  "required": [
    "incident_id",
    "status",
    "suspected_root_cause",
    "confidence",
    "signature_version",
    "agent_trace_id"
  ],
  "title": "Report",
  "type": "object"
}
